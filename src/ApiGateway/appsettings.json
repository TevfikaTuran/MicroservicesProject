{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "JwtSettings": {
    "Secret": "YourSuperSecretKeyForJwtTokenGeneration2024MicroservicesProject!",
    "Issuer": "MicroservicesProject.AuthService",
    "Audience": "MicroservicesProject"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "products-route": {
        "ClusterId": "product-cluster",
        "Match": { "Path": "/api/products/{**catch-all}" }
      },
      "logs-route": {
        "ClusterId": "log-cluster",
        "Match": { "Path": "/api/logs/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": { "auth-api": { "Address": "http://localhost:5001" } }
      },
      "product-cluster": {
        "Destinations": { "product-api": { "Address": "http://localhost:5002" } }
      },
      "log-cluster": {
        "Destinations": { "log-api": { "Address": "http://localhost:5003" } }
      }
    }
  },
  "AllowedHosts": "*"
}
